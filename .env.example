# Variables de entorno para el backend (copiar a .env y ajustar si hace falta)
# Valores por defecto de docker-compose / README (BD local "netops"):
DATABASE_URL=postgresql+psycopg2://netops:netops@localhost:5432/netops
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SSL de la base de datos (opcional). Por defecto se exige SSL salvo en
# localhost / servicios de Docker. Valores: disable | prefer | require
# DB_SSLMODE=require

# --- Acceso (inicio de sesión) ---------------------------------------------
# Cuenta de ADMINISTRADOR. Si defines las dos, esa cuenta existe siempre y con esas
# credenciales entras directo como administrador (en cada arranque se vuelve a fijar esa clave).
# Si no las defines y aún no hay administrador, se crea "admin" con una clave aleatoria
# que aparece UNA vez en el registro (logs) del servidor.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave
# Clave con la que se firman las sesiones. Opcional: si no la pones se genera sola y se guarda en la base de datos.
# JWT_SECRET=una-frase-larga-y-secreta
# Zona horaria para las fechas de vencimiento y el límite diario (horas respecto a UTC). Perú = -5.
# APP_UTC_OFFSET_HOURS=-5
